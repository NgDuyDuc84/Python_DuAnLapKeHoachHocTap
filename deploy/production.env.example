# Copy outside Git to .env.production and replace all example/blank values.
DJANGO_SETTINGS_MODULE=config.production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=study.example.com
SITE_URL=https://study.example.com
DATABASE_URL=
HOST=0.0.0.0
PORT=8000
# Set to the actual trusted reverse proxy IP. Leave blank if there is no proxy.
# Only use * when the application port is private and all upstreams are trusted.
TRUSTED_PROXY=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Nhịp Học <noreply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://study.example.com/integrations/google/callback/
GOOGLE_TOKEN_ENCRYPTION_KEY=
# On Render Free use notifications.gmail_backend.EmailBackend instead of SMTP.
GMAIL_REFRESH_TOKEN=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
