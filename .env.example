# Local development settings. Keep your actual .env file outside Git.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=django-insecure-local-only-change-before-deployment
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# Leave empty for local SQLite. PostgreSQL URLs may include ?sslmode=require.
DATABASE_URL=

# Local email preview: messages appear in the reminder worker terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Nhịp Học <noreply@example.test>
SITE_URL=http://127.0.0.1:8000

# For real delivery, set EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend
# and configure your provider below in your ignored .env, never in Git.
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# Optional Google Calendar OAuth (Web application client, Calendar API enabled).
# Register this exact redirect URI in Google Cloud; use HTTPS when deployed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/integrations/google/callback/
# Generate once with cryptography.fernet.Fernet.generate_key(); keep outside Git.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Render Free blocks SMTP. To send with Gmail over HTTPS instead, set
# EMAIL_BACKEND=notifications.gmail_backend.EmailBackend
# DEFAULT_FROM_EMAIL=Nhịp Học <your-account@example.com>
# GOOGLE_CLIENT_ID/SECRET above must match the client used to obtain this token.
# Authorize only https://www.googleapis.com/auth/gmail.send with your own OAuth client.
GMAIL_REFRESH_TOKEN=

# Optional AI reports through Groq Free Plan; no paid upgrade is required.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
